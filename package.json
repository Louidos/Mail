{
  "name": "sichermail",
  "private": true,
  "version": "0.1.0",
  "description": "SicherMail – sicherer Open-Source-Mailclient für den Desktop",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --config src/vite.config.ts",
    "build": "tsc -p src/tsconfig.json && vite build --config src/vite.config.ts",
    "test": "vitest run --config src/vite.config.ts",
    "lint": "eslint --config src/eslint.config.js . && tsc -p src/tsconfig.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.0",
    "typescript": "~5.9.2",
    "eslint": "^9.36.0",
    "@eslint/js": "^9.36.0",
    "typescript-eslint": "^8.44.0",
    "globals": "^16.4.0",
    "happy-dom": "^20.0.0"
  }
}
