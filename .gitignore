# Abhängigkeiten und Build-Ausgaben
node_modules/
dist/
src-tauri/target/
src-tauri/gen/schemas/
coverage/

# Geheimnisse – nie committen, nur Beispieldateien (*.example)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
!tests/**/*.example.pem
# Ausnahme: eigens erzeugte S/MIME-Test-PKI ohne echten Wert (siehe LIESMICH.md dort)
!tests/integration/daten/smime/*.pem
!tests/integration/daten/smime/*.key
!tests/integration/daten/smime/*.p12

# Test-Mailserver (wird von scripts/test-mailserver.sh erzeugt)
.testserver/

# Editor und Betriebssystem
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
